OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
# Judge for evaluation (Phase 4): stronger than, and different from, the chat model it grades
OPENAI_JUDGE_MODEL=gpt-4.1

# Embeddings: openai | hf  (hf = local HuggingFace model, runs on your machine)
EMBED_PROVIDER=hf
OPENAI_EMBED_MODEL=text-embedding-3-small
# Lightweight options: BAAI/bge-small-en-v1.5 (33M, 384d), sentence-transformers/all-MiniLM-L6-v2 (22M, 384d)
HF_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Optional HuggingFace token (hf_...): only for gated/private models or higher download rate limits
HF_TOKEN=

# Reranker (local cross-encoder). Alternatives: BAAI/bge-reranker-base (bigger, stronger)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# SEC EDGAR data download (required by SEC: name + contact email)
SEC_USER_AGENT=Your Name you@example.com

# Phase 7 service (phase7_production/service.py Settings; all optional)
# LLM_BACKEND=openai            # stub = no LLM calls (rule plan + extractive answer), for load tests / no key
# VECTOR_DB=chroma              # qdrant after: uv run python -m phase7_production.05_vector_db --migrate
# GUARDRAIL_MODE=post           # buffer = hold the answer until output checks ran
# SEMANTIC_CACHE=0              # measured unsafe for numeric questions (phase7_production/03_cache.py)
# ONLINE_EVAL_RATE=0.1
# OPENAI_MAX_RETRIES=8          # the service itself uses 1 retry and a 20 s timeout
# OPENAI_TIMEOUT_S=600
